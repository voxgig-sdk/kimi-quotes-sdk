# Entity: quote

main: kit: entity: quote: {

  alias: field: {}

  fields: [
    {
      name: "context"
      req: false
      short: "The context in which the quote was said (e.g., team radio, interview)"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the quote"
      type: "`$INTEGER`"
    }
    {
      name: "quote"
      req: true
      short: "The actual quote text from Kimi Räikkönen"
      type: "`$STRING`"
    }
    {
      name: "year"
      req: false
      short: "The year when the quote was said"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/quotes"
          segments: [
            {
              lit: "quotes"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/quote"
          segments: [
            {
              lit: "quote"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
